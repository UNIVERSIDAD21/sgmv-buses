# General
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:4000

# Backend
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public
SEED_USER_PASSWORD=replace-with-a-demo-only-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=sgmv-api
JWT_AUDIENCE=sgmv-web
COOKIE_NAME=sgmv_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=sgmv_csrf
CSRF_SECRET=replace-with-a-long-random-secret
CSRF_TOKEN_TTL_MS=7200000
RATE_LIMIT_SECRET=replace-with-a-different-long-random-secret
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS=100
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
IDEMPOTENCY_IN_PROGRESS_TTL_MS=120000
IDEMPOTENCY_RESPONSE_MAX_BYTES=262144
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
PREVENTIVE_SOON_DAYS=7
PREVENTIVE_SOON_KM=500
